[Unit]
Description=Gimbal touchscreen kiosk (cage)
After=gimbal-web.service systemd-user-sessions.service
Wants=gimbal-web.service

[Service]
User=pi
# run on the console seat so cage can grab the DSI display (DRM/KMS)
TTYPath=/dev/tty1
PAMName=login
Environment=XDG_RUNTIME_DIR=/run/user/1000
# cage launches a single fullscreen Wayland app -> our chromium kiosk
ExecStart=/usr/bin/cage -- /home/pi/feiyu-gimbal/rpi/kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
